# Local database started with `pnpm db:start`
DATABASE_URL=postgres://deems@127.0.0.1:55433/deems_luxe

# Long random string, e.g. `openssl rand -base64 32`
PAYLOAD_SECRET=

NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Google Cloud console > APIs & Services > Credentials > OAuth client (Web application)
# Authorised redirect URI: <NEXT_PUBLIC_SERVER_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that become admins on their first Google sign-in
BOOTSTRAP_ADMIN_EMAILS=

# Lead emails go through Resend. Without these, leads still save but show "Failed, will retry".
# The lead inbox address is set in the admin panel under Site settings.
RESEND_API_KEY=
LEAD_FROM_EMAIL="Deems Luxe Homes <requests@your-domain>"

# Long random string. Vercel Cron sends it to /api/cron/lead-emails to retry failed lead emails.
CRON_SECRET=

# Optional: forms one sender may send in 15 minutes (default 5)
# LEAD_RATE_LIMIT=5
